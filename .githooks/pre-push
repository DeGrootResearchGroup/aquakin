#!/usr/bin/env bash
#
# Pre-push hook: run the same ruff gate CI enforces, so a formatting or lint
# slip is caught locally instead of turning the required `lint (ruff)` job red
# on the PR. Mirrors the CI `lint` job exactly:
#     ruff check aquakin aquakin_ui tests scripts examples
#     ruff format --check aquakin aquakin_ui
# and, when pyright is installed, the CI `typecheck` job's `pyright`.
#
# Enable it once per clone (git does not install repo hooks automatically):
#     git config core.hooksPath .githooks
#
# Bypass for a one-off push with:  git push --no-verify
#
set -euo pipefail

# No commit being pushed may link to the Claude session that wrote it: a session
# link means nothing to a reader of the repository, and the session can be
# private (CLAUDE.md, "Pushing and merging"). git gives one line per ref on
# stdin: "<local ref> <local sha> <remote ref> <remote sha>". The commits pushed
# are those in local_sha not yet on the remote (all of them not on any
# remote-tracking ref, for a new branch). This runs before the ruff gate, which
# exits early when ruff is not installed.
zero=0000000000000000000000000000000000000000
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue          # a branch deletion
  if [ "$remote_sha" = "$zero" ]; then
    range=("$local_sha" --not --remotes)
  else
    range=("$remote_sha..$local_sha")
  fi
  linked=""
  for commit in $(git rev-list "${range[@]}"); do
    if git log -1 --format=%B "$commit" | grep -q 'claude\.ai/code/session_'; then
      linked+="  $(git log -1 --format='%h %s' "$commit")"$'\n'
    fi
  done
  if [ -n "$linked" ]; then
    echo "pre-push: blocked. These commit messages link to a Claude session:" >&2
    printf '%s' "$linked" >&2
    echo "          Remove the link (git commit --amend, or git rebase -i for older commits) and push again." >&2
    exit 1
  fi
done

# Use whatever ruff is on PATH (the project's pinned one after
# `pip install -e ".[lint]"`). If ruff is not installed, warn but do not block
# the push -- a contributor without the lint extra should not be stuck.
if ! command -v ruff >/dev/null 2>&1; then
  echo "pre-push: ruff not found on PATH -- skipping the lint gate." >&2
  echo "          install it with:  pip install -e \".[lint]\"" >&2
  exit 0
fi

fail=0

echo "pre-push: ruff check aquakin aquakin_ui tests scripts examples" >&2
if ! ruff check aquakin aquakin_ui tests scripts examples; then
  echo "pre-push: 'ruff check aquakin aquakin_ui tests scripts examples' reported errors (see above)." >&2
  fail=1
fi

echo "pre-push: ruff format --check aquakin aquakin_ui" >&2
if ! ruff format --check aquakin aquakin_ui; then
  echo "pre-push: files are not formatted -- run 'ruff format aquakin aquakin_ui', commit, and re-push." >&2
  fail=1
fi

# The CI `typecheck` job: pyright over aquakin_ui ([tool.pyright] in pyproject.toml).
# It needs the `typecheck` and `ui` extras; without pyright, say so and go on.
if command -v pyright >/dev/null 2>&1; then
  echo "pre-push: pyright" >&2
  if ! pyright; then
    echo "pre-push: pyright reported errors in aquakin_ui (see above)." >&2
    fail=1
  fi
else
  echo "pre-push: pyright not found -- skipping the type check." >&2
  echo "          install it with:  pip install -e \".[ui,typecheck]\"" >&2
fi

if [ "$fail" -ne 0 ]; then
  echo "pre-push: blocked. Fix the issues above (or 'git push --no-verify' to bypass)." >&2
  exit 1
fi

echo "pre-push: all gates that ran are clean." >&2
